// TrimTown Database Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  BARBER
  ADMIN
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  CLOSED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SalonVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String
  email       String?  @unique
  avatarUrl   String?
  role        UserRole @default(CUSTOMER)
  fcmToken    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  appointments Appointment[]
  reviews      Review[]
  favorites    FavoriteSalon[]
  barberProfile Barber?

  @@map("users")
}

model Salon {
  id               String                  @id @default(uuid())
  name             String
  description      String?
  ownerName        String
  phone            String
  address          String
  area             String
  city             String                  @default("Haldwani")
  state            String                  @default("Uttarakhand")
  lat              Float
  lng              Float
  photoUrl         String?
  photos           String[]
  isActive         Boolean                 @default(true)
  verificationStatus SalonVerificationStatus @default(PENDING)
  verifiedAt       DateTime?
  openTime         String                  @default("09:00")
  closeTime        String                  @default("20:00")
  workingDays      Int[]                   // 0=Sun, 1=Mon ... 6=Sat
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relations
  barbers      Barber[]
  favorites    FavoriteSalon[]

  @@map("salons")
}

model Barber {
  id          String   @id @default(uuid())
  userId      String   @unique
  salonId     String
  name        String
  bio         String?
  photoUrl    String?
  experience  Int      @default(0) // years
  specialties String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  salon        Salon         @relation(fields: [salonId], references: [id])
  services     Service[]
  availability Availability?
  appointments Appointment[]
  reviews      Review[]

  @@map("barbers")
}

model Service {
  id           String   @id @default(uuid())
  barberId     String
  name         String
  description  String?
  price        Float
  durationMins Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  barber       Barber        @relation(fields: [barberId], references: [id])
  appointments AppointmentService[]

  @@map("services")
}

model Availability {
  id           String             @id @default(uuid())
  barberId     String             @unique
  status       AvailabilityStatus @default(CLOSED)
  queueCount   Int                @default(0)
  maxQueueSize Int                @default(10)
  updatedAt    DateTime           @updatedAt

  // Relations
  barber       Barber   @relation(fields: [barberId], references: [id])
  queueEntries QueueEntry[]

  @@map("availability")
}

model QueueEntry {
  id             String   @id @default(uuid())
  availabilityId String
  customerId     String
  customerName   String
  position       Int
  appointmentId  String?
  addedAt        DateTime @default(now())

  // Relations
  availability Availability @relation(fields: [availabilityId], references: [id])

  @@map("queue_entries")
}

model Appointment {
  id         String            @id @default(uuid())
  userId     String
  barberId   String
  slotTime   DateTime
  status     AppointmentStatus @default(PENDING)
  totalPrice Float
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Relations
  user     User                 @relation(fields: [userId], references: [id])
  barber   Barber               @relation(fields: [barberId], references: [id])
  services AppointmentService[]
  review   Review?

  @@map("appointments")
}

model AppointmentService {
  id            String @id @default(uuid())
  appointmentId String
  serviceId     String
  price         Float
  durationMins  Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@map("appointment_services")
}

model Review {
  id            String   @id @default(uuid())
  userId        String
  barberId      String
  appointmentId String   @unique
  rating        Int      // 1-5
  comment       String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  barber      Barber      @relation(fields: [barberId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("reviews")
}

model FavoriteSalon {
  id        String   @id @default(uuid())
  userId    String
  salonId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  salon Salon @relation(fields: [salonId], references: [id])

  @@unique([userId, salonId])
  @@map("favorite_salons")
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
